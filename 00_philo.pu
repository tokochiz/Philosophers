@startuml
skinparam {
    DefaultFontName MS Gothic
    ActivityBackgroundColor LightBlue
    ActivityBorderColor Black
    ActivityDiamondBackgroundColor LightYellow
}

title 哲学者の問題 - プログラム実行フロー（並行処理）

|Main|
start
:main(argc, argv);

|#AntiqueWhite|Setup|
:引数検証と初期化処理;

:start_table(table);
note right
  start_timeを設定
  start_time = 現在時刻 + 500μs
end note

if (哲学者1人?) then (yes)
    :start_one_philo(table);
else (no)
    fork
        |#LightGreen|Philosopher Threads|
        :各哲学者のスレッド作成;
        partition "哲学者の状態遷移" {
            while (プログラム実行中)
                :フォーク取得待機;
                :食事;
                :睡眠;
                :思考;
            endwhile
        }
        
    fork again
        |#Pink|Monitor Thread|
        partition "状態監視" {
            :monitor_all_philos開始;
            while (プログラム実行中)
                :各哲学者の状態チェック;
                if (死亡検知?) then (yes)
                    :死亡状態を記録;
                    :プログラム終了フラグ設定;
                endif
                :10μs待機;
            endwhile
        }
    end fork
endif

|Main|
:join_all_threads(table);
:end_table(table);
stop

legend right
    |色|意味|
    |#AntiqueWhite|Setup処理|
    |#LightGreen|哲学者スレッド|
    |#Pink|モニタースレッド|
    |= |Main処理|
endlegend

@enduml
